# Installed and enabled by scripts/provision-host.sh. See docs/operations.md, "Interrupted updates".
[Unit]
Description=cave_system: at boot, finish an update interrupted by a power cut or a crash
Documentation=https://github.com/oxydonth/cave_system/blob/main/docs/operations.md
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/cave/.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cave
# Does nothing unless an update was interrupted; then it starts the previous release again or
# rolls the switch back. It waits for a backup that holds the lock.
ExecStart=/opt/cave/cave update --recover
TimeoutStartSec=5h

[Install]
WantedBy=multi-user.target
