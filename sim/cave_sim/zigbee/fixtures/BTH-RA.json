      },
      "max_temp": "30",
      "min_temp": "5",
      "mode_command_template": "{% set values = { 'auto':'schedule','heat':'manual','off':'pause'} %}{\"operating_mode\": \"{{ values[value] if value in values.keys() else 'pause' }}\"}",
      "mode_command_topic": "zigbee2mqtt/@FRIENDLY_NAME@/set",
      "mode_state_template": "{% set values = {'schedule':'auto','manual':'heat','pause':'off'} %}{% set value = value_json.operating_mode %}{{ values[value] if value in values.keys() else 'off' }}",
      "mode_state_topic": "zigbee2mqtt/@FRIENDLY_NAME@",
      "modes": [
        "off",
        "heat",
        "auto"
      ],
      "name": null,
      "object_id": "@OBJECT_ID@",
      "origin": {
        "name": "Zigbee2MQTT",
        "sw": "2.14.3",
        "url": "https://www.zigbee2mqtt.io"
      },
      "temp_step": 0.5,
      "temperature_command_topic": "zigbee2mqtt/@FRIENDLY_NAME@/set/occupied_heating_setpoint",
