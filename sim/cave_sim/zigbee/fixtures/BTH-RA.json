        "name": "Zigbee2MQTT",
        "sw": "2.14.3",
        "url": "https://www.zigbee2mqtt.io"
      },
      "payload_off": false,
      "payload_on": true,
      "state_topic": "zigbee2mqtt/@FRIENDLY_NAME@",
      "unique_id": "@IEEE@_automatic_valve_adapt_zigbee2mqtt",
      "value_template": "{% if \"automatic_valve_adapt\" in value_json %}{{ value_json[\"automatic_valve_adapt\"] }}{% endif %}"
    },
