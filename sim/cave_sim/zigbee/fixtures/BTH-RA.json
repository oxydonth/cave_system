    "binary_sensor/@IEEE@/automatic_valve_adapt/config": {
      "availability": [
        {
          "topic": "zigbee2mqtt/bridge/state",
          "value_template": "{{ value_json.state }}"
        },
        {
          "topic": "zigbee2mqtt/@FRIENDLY_NAME@/availability",
          "value_template": "{{ value_json.state }}"
        }
      ],
      "availability_mode": "all",
      "default_entity_id": "binary_sensor.@OBJECT_ID@_automatic_valve_adapt",
      "device": {
        "identifiers": [
          "zigbee2mqtt_@IEEE@"
        ],
        "manufacturer": "Bosch",
        "model": "Radiator thermostat II",
        "model_id": "BTH-RA",
        "name": "@FRIENDLY_NAME@",
        "sw_version": "Zigbee2MQTT 2.14.3",
