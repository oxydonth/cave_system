# Example of the `.env` file that `./cave init` creates in the checkout (mode 0600, never
# committed). You normally do not copy this file: init writes the real one and generates the
# passwords and tokens that are empty here. Docker Compose reads the real file as well.
#
# A value that contains `$` or ` #` must be written in single quotes: 'pa$$word'.

# State directory: Home Assistant's /config, Zigbee2MQTT's and Mosquitto's data.
# Never in Git.
# `./cave init` writes /var/lib/cave on a provisioned server and ./data (as an
# absolute path) in a development checkout, unless CAVE_DATA is set in its environment.
CAVE_DATA=/var/lib/cave

# Time zone of every service.
TZ=Europe/Berlin

# Empty, or `zigbee` once a coordinator is connected: whether Zigbee2MQTT runs.
COMPOSE_PROFILES=

# MQTT broker login, used by Home Assistant, Zigbee2MQTT and the simulators.
CAVE_MQTT_USER=cave

# Generated by init; also written, hashed, to the broker's password file
# in CAVE_DATA/mosquitto.
CAVE_MQTT_PASSWORD=

# Home Assistant's owner account, created by `./cave bootstrap`: display name.
CAVE_HA_OWNER_NAME=Owner

# Owner account: login name.
CAVE_HA_OWNER_USER=owner

# Owner account: password, generated by init.
CAVE_HA_OWNER_PASSWORD=

# Zigbee coordinator, set by you: tcp://<address>:6638 for a network coordinator such as
# the SMLIGHT SLZB-06MG24, or a /dev/serial/by-id/... path (a USB coordinator also needs
# a compose.override.yaml that passes the device in, see docs/install.md).
CAVE_Z2M_SERIAL_PORT=

# Zigbee coordinator driver: `ember` (SLZB-06MG24) or `zstack`.
CAVE_Z2M_ADAPTER=ember

# Token for Zigbee2MQTT's web UI on port 8080, generated by init.
CAVE_Z2M_FRONTEND_TOKEN=

# Optional: FRITZ!Box address (for example fritz.box) for the FRITZ! integrations.
CAVE_FRITZ_HOST=

# Optional: FRITZ!Box user for the FRITZ! integrations.
CAVE_FRITZ_USER=

# Optional: FRITZ!Box password. In single quotes if it contains `$` or ` #`.
CAVE_FRITZ_PASSWORD=

# `1`: the nightly timer installs new releases. `0`: manual updates only.
CAVE_AUTO_UPDATE=1

# Where `cave backup` writes its archives.
CAVE_BACKUP_DIR=/var/backups/cave

# How many backup archives to keep.
CAVE_BACKUP_KEEP=14

# Optional second location that backups are copied to.
CAVE_BACKUP_COPY_TO=

# Optional: a URL that short alerts are posted to (ntfy's format) when the stack has been
# down for 15 minutes, or an update, backup or restore needs you; also while Home
# Assistant cannot tell you. For example a topic of an ntfy server on the home network.
# Empty: nothing leaves the server. A token in it is never printed. See docs/operations.md.
CAVE_ALERT_URL=
